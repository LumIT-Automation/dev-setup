  ############################################################################################
  # API Netscaler
  ############################################################################################

  config.vm.define :apinetscaler do |api|
    api.vm.provider "virtualbox" do |vb|
      vb.gui = false
      vb.memory = "1024"
      vb.cpus = 2
      vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"] # https://serverfault.com/questions/453185/vagrant-virtualbox-dns-10-0-2-3-not-working
    end

    api.vm.provider "libvirt" do |libvrt|
      libvrt.memory = "1024"
      libvrt.cpus = 2
    end

    # OS.
    api.vm.box = "debian/bookworm64"

    # Network.
    api.vm.network :private_network, ip: "10.0.111.34"
    api.vm.hostname = "apinetscaler"

    # Synced folders.
    if OS.linux?
      api.vm.synced_folder "../api-netscaler", "/var/www/api", type: "nfs", nfs_version: 4

      if File.directory?(File.expand_path("../customer-usecases"))
        api.vm.synced_folder "../customer-usecases", "/var/www/usecases", type: "nfs", nfs_version: 4
      end
    end

    if OS.mac?
      api.vm.synced_folder "../api-netscaler", "/var/www/api", type: "nfs", nfs_udp: false
    end
    if OS.windows?
      api.vm.synced_folder "../api-netscaler", "/var/www/api", type: "smb"
    end

    # Alternative debian mirror.
    if File.exist?("api-netscaler/sources.list")
      api.vm.provision "file", source: "api-netscaler/sources.list", destination: "/tmp/sources.list"
    end

    # Provision.
    api.vm.provision "shell" do |s|
      s.path = "api-netscaler/bootstrap.sh"
      s.args = ["--action", "install"]
    end
    api.vm.provision "customers", type: "shell" do |s|
      s.path = "api-netscaler/setup-customers.sh"
      s.args = ["--action", "run"]
    end
    api.vm.provision "db", type: "shell" do |s|
      s.path = "api-netscaler/db-bootstrap.sh"
      s.args = ["--action", "run"]
    end
  end
