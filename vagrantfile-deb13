  ############################################################################################
  # Empty Debian 13 vm
  ############################################################################################

  config.vm.define :deb13 do |empty|
    empty.vm.provider "virtualbox" do |vb|
      vb.gui = false
      vb.memory = "2048"
      vb.cpus = 1
      vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    end

    empty.vm.provider "libvirt" do |libvrt|
      libvrt.memory = "2048"
      libvrt.cpus = 1
    end

    # OS.
    empty.vm.box = "boxen/debian-13"

    # Network.
    empty.vm.network :private_network, ip: "10.0.111.206"
    empty.vm.hostname = "deb13"

    # Provision.
    empty.vm.provision "shell" do |s|
      s.path = "deb13/bootstrap.sh"
      s.args = ["--action", "install"]
    end
  end
