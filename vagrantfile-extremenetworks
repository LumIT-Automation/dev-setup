  ############################################################################################
  # Extreme Networks
  ############################################################################################

  config.vm.define :apiextremenetworks do |extreme|
    extreme.vm.provider "virtualbox" do |vb|
      vb.gui = true
      vb.memory = "2048"
      vb.cpus = 2
      vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"] # https://serverfault.com/questions/453185/vagrant-virtualbox-dns-10-0-2-3-not-working
    end

    extreme.vm.provider "libvirt" do |libvrt|
      libvrt.memory = "2048"
      libvrt.cpus = 2
    end

    # OS.
    extreme.vm.box = "cloud-image/debian-13"

    # Network.
    extreme.vm.network :private_network, ip: "10.0.111.33"
    extreme.vm.hostname = "api"

    # Synced folders.
    if OS.linux?
      extreme.vm.synced_folder "../api-extremenetworks", "/var/www/api", type: "nfs", nfs_version: 4
    end
    if OS.mac?
      extreme.vm.synced_folder "../api-extremenetworks", "/var/www/api", type: "nfs", nfs_udp: false
    end
    if OS.windows?
      extreme.vm.synced_folder "../api-extremenetworks", "/var/www/api", type: "smb"
    end

    # Synced folders - /vagrant.
    if OS.linux?
      extreme.vm.synced_folder ".", "/vagrant", type: "nfs", nfs_version: 4
    end
    if OS.mac?
      extreme.vm.synced_folder ".", "/vagrant", type: "nfs", nfs_udp: false
    end
    if OS.windows?
      extreme.vm.synced_folder ".", "/vagrant", type: "smb"
    end

    # Provision.
    extreme.vm.provision "shell" do |s|
      s.path = "api-extremenetworks/bootstrap.sh"
      s.args = ["--action", "install"]
    end
    extreme.vm.provision "db", type: "shell" do |s|
      s.path = "api-extremenetworks/db-bootstrap.sh"
      s.args = ["--action", "run"]
    end
  end
